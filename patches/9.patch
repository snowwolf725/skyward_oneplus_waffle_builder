+/// Put the tools on the ramdisk: files beside `root` go to system/bin,
+/// those under `root/lib64` to system/lib64. A name already there is
+/// replaced with the tool's own contents and mode.
+fn add_tools(rd: &mut Ramdisk, root: &Path) -> Result<()> {
+    let put = |rd: &mut Ramdisk, name: &str, mode: u32, data: Vec<u8>| -> Result<()> {
+        let remove = match rd.find(name) {
+            Some(e) => {
+                ensure!(!e.is_dir(), "{name} is a directory in the ramdisk");
+                true
+            }
+            None => false,
+        };
+        if remove {
+            rd.entries.retain(|e| e.name != name);
+        }
+        rd.add(name, mode, data)
+    };
+    let link = |rd: &mut Ramdisk, name: &str, target: &str| -> Result<()> {
+        let remove = match rd.find(name) {
+            Some(e) => {
+                ensure!(!e.is_dir(), "{name} is a directory in the ramdisk");
+                true
+            }
+            None => false,
+        };
+        if remove {
+            rd.entries.retain(|e| e.name != name);
+        }
+        rd.link(name, target)
+    };
+
+    let lib = root.join("lib64");
+    for (dir, into) in [(root, "system/bin"), (lib.as_path(), "system/lib64")] {
+        let mut paths = Vec::new();
+        for entry in std::fs::read_dir(dir).with_context(|| format!("read {}", dir.display()))? {
+            paths.push(entry.with_context(|| format!("read an entry in {}", dir.display()))?.path());
+        }
+        paths.sort();
+        for path in paths {
+            let meta = std::fs::symlink_metadata(&path).with_context(|| format!("stat {}", path.display()))?;
+            let file_name = path.file_name().with_context(|| format!("name of {}", path.display()))?;
+            let name = file_name.to_str().with_context(|| format!("name of {}", path.display()))?;
+            let target = format!("{into}/{name}");
+            if meta.file_type().is_symlink() {
+                let to = std::fs::read_link(&path).with_context(|| format!("read link {}", path.display()))?;
+                let to = to.to_str().with_context(|| format!("target of {}", path.display()))?;
+                link(rd, &target, to)?;
+            } else if meta.is_file() {
+                let mode = meta.permissions().mode() & 0o777;
+                let data = std::fs::read(&path).with_context(|| format!("read {}", path.display()))?;
+                put(rd, &target, mode, data)?;
+            }
+        }
+    }
+    Ok(())
+}
